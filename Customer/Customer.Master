<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Customer.master.cs" Inherits="WebApplication1.CustomerPages.CustomerMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">BoxFactory Customer Portal</asp:ContentPlaceHolder></title>

    <link href="<%= ResolveUrl("~/Content/boxfactory.css") %>" rel="stylesheet" type="text/css" />
    <link rel="shortcut icon" href="<%= ResolveUrl("~/favicon.ico") %>" type="image/x-icon" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server" ClientIDMode="Static">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" />

        <div id="screen-customer-portal" class="screen-view active-screen purple-portal">
            <div class="app-container">
                <!-- Customer Sidebar -->
                <aside class="app-sidebar">
                    <div class="sidebar-header">
                        <div class="sidebar-logo-icon">B</div>
                        <div style="flex-grow: 1;">
                            <div class="sidebar-brand-text">BoxFactory</div>
                            <span class="portal-tag-badge purple-badge">CUSTOMER PORTAL</span>
                        </div>
                    </div>

                    <div class="sidebar-section-label">PORTAL</div>

                    <ul class="sidebar-menu">
                        <li class='<%= GetNavClass("home") %>'>
                            <a href="<%= ResolveUrl("~/Customer/Home.aspx") %>" style="display:flex; align-items:center; gap:12px; color:inherit; text-decoration:none; width:100%;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                                <span>Home</span>
                            </a>
                        </li>
                        <li class='<%= GetNavClass("place-order") %>'>
                            <a href="<%= ResolveUrl("~/Customer/PlaceOrder.aspx") %>" style="display:flex; align-items:center; gap:12px; color:inherit; text-decoration:none; width:100%;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                                <span>Place Order</span>
                            </a>
                        </li>
                        <li class='<%= GetNavClass("track-order") %>'>
                            <a href="<%= ResolveUrl("~/Customer/TrackOrder.aspx") %>" style="display:flex; align-items:center; gap:12px; color:inherit; text-decoration:none; width:100%;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                                <span>Track Order</span>
                            </a>
                        </li>
                        <li class='<%= GetNavClass("my-orders") %>'>
                            <a href="<%= ResolveUrl("~/Customer/MyOrders.aspx") %>" style="display:flex; align-items:center; gap:12px; color:inherit; text-decoration:none; width:100%;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                                <span>My Orders</span>
                            </a>
                        </li>
                    </ul>

                    <div class="sidebar-footer-user">
                        <div class="user-profile-summary">
                            <div class="avatar-circle purple-avatar"><asp:Literal ID="litAvatar" runat="server">AL</asp:Literal></div>
                            <div>
                                <div class="user-name-tag"><asp:Literal ID="litUserName" runat="server">Apex Logistics</asp:Literal></div>
                                <div class="user-role-subtext">Verified Client</div>
                            </div>
                        </div>
                        <asp:Button ID="btnSignOutCustomer" runat="server" Text="Sign Out" CssClass="btn-signout" OnClick="btnSignOut_Click" CausesValidation="false" />
                    </div>
                </aside>

                <!-- Customer Main Content -->
                <main class="app-main">
                    <div class="portal-topbar">
                        <h1 class="portal-page-title" id="customerPageTitle">
                            <asp:ContentPlaceHolder ID="PageHeaderTitle" runat="server">Home</asp:ContentPlaceHolder>
                        </h1>
                        <div style="display:flex; align-items:center; gap: 8px;">
                            <span style="font-size:13px; font-weight:700; color:#334155;"><asp:Literal ID="litTopShortName" runat="server">Apex</asp:Literal></span>
                            <div class="avatar-circle purple-avatar" style="width:30px; height:30px; font-size:11px;"><asp:Literal ID="litTopAvatar" runat="server">AL</asp:Literal></div>
                        </div>
                    </div>

                    <div class="portal-content-body">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                    </div>
                </main>
            </div>
        </div>

        <asp:ContentPlaceHolder ID="ModalContent" runat="server" />

        <!-- Toast Notification Alert -->
        <asp:Label ID="toastNotification" runat="server" CssClass="toast-notice" />
    </form>

    <script src="<%= ResolveUrl("~/Scripts/boxfactory.js") %>" type="text/javascript" charset="utf-8"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
